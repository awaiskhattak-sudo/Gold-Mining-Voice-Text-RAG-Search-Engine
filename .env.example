# Local Ollama Configuration (Default v0.40.0)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Rate Limiting & Security
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
