# ============================================================
# AuriSearch Gold Mining RAG Engine Configuration
# ============================================================

# Google AI Studio API Key (Paste your API key below from https://aistudio.google.com/)
GEMINI_API_KEY=GEMINI_API_KEY=YOUR_SECRET_KEY_HERE


# Gemini Model Selection (Recommended: gemini-2.0-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Local Ollama Configuration (v0.40.0)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Defensive Limits & Rate Limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_QUERY_LENGTH=800
MIN_QUERY_LENGTH=2
